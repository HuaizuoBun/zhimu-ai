{
  "name": "zhimu-ai",
  "version": "1.0.2",
  "description": "知幕 AI —— 把长视频变成按主题组织的详细文章笔记（B 站与本地视频）",
  "author": "知幕 AI",
  "private": true,
  "main": "desktop/dist/main/index.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "node node_modules/vinext/dist/cli.js build && node --test tests/rendered-html.test.mjs tests/api-pipeline.test.mjs tests/article-markdown.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern desktop/dist --ignore-pattern \"desktop/release*\"",
    "db:generate": "drizzle-kit generate",
    "desktop:build": "node desktop/scripts/build.mjs",
    "desktop:dev": "node desktop/scripts/build.mjs && electron .",
    "desktop:test": "node desktop/scripts/build-test.mjs && node --test tests/desktop-server.test.mjs tests/desktop-storage.test.mjs tests/desktop-p4.test.mjs",
    "desktop:pack": "node desktop/scripts/build.mjs && electron-builder --dir",
    "desktop:dist": "node desktop/scripts/build.mjs && electron-builder --win nsis"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@hono/node-server": "^2.1.1",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "hono": "^4.13.8",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "allowScripts": {
    "sharp@0.34.5": true,
    "workerd@1.20260515.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.3": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
